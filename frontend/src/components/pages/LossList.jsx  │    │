import { useEffect, useState } from "react";
import API from "../services/api";

function LossList() {
  const [losses, setLosses] = useState([]);

  useEffect(() => {
    fetchLosses();
  }, []);

  const fetchLosses = async () => {
    try {
      const res = await API.get("/losses");
      setLosses(res.data);
    } catch (err) {
      console.error(err);
    }
  };

  return (
    <div style={{ padding: "20px" }}>
      <h1>Loss List</h1>

      <table border="1">
        <thead>
          <tr>
            <th>ID</th>
            <th>Amount</th>
            <th>Description</th>
          </tr>
        </thead>
        <tbody>
          {losses.map((loss) => (
            <tr key={loss.id}>
              <td>{loss.id}</td>
              <td>{loss.amount}</td>
              <td>{loss.description}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  );
}

export default LossList;